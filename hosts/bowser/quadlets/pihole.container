[Unit]
Description=Pihole

[Container]
ContainerName=pihole
Environment=TZ=America/New_York
Environment=FTLCONF_dns_listeningMode=ALL

Secret=pihole_webpassword,target=FTLCONF_webserver_api_password

Image=docker.io/pihole/pihole:latest
AutoUpdate=registry

# Port mappings
# sudo sysctl -w net.ipv4.ip_unprivileged_port_start=53
#
PublishPort=53:53/tcp
PublishPort=53:53/udp
PublishPort=80:80/tcp
PublishPort=443:443/tcp

Volume=pihole-etc:/etc/pihole
Volume=pihole-dnsmasq:/etc/dnsmasq.d

HealthCmd=curl -fsS http://localhost:80/admin || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=60s

[Service]
Restart=always

[Install]
WantedBy=default.target
