variant: fcos
version: 1.7.0
systemd:
  units:
    - name: podman.socket
      enabled: true
passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDu3b0sR30apw6ot/2esLkxRqmjjw1zfzSLYm6sfohwY doug@wario
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAcEz5hdQTZSv5rtcVjDeDgfA+r7AFsua8k8FQxxp8rB doug@ganon
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEri7IoTkuqP0dbjB4k/mDxuILXvwy6VsGcAbC2Q+yQ0 doug@bowser

storage:
  directories:
    # Explicit host bind-mount directory for document tracking
    - path: /opt/paperless/consume
      mode: 0755
      user: { name: root }

  files:
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: paperless
    - path: /etc/fstab
      append:
        - inline: |
              192.168.1.5:/deadpool/doug    /mnt/deadpool/    nfs    defaults    0 0
    - path: /etc/NetworkManager/system-connections/enp1s0.nmconnection
      mode: 0600
      contents:
        inline: |
          [connection]
          id=enp1s0
          type=ethernet
          interface-name=enp1s0
          [ipv4]
          address1=192.168.1.103/24,192.168.1.1
          dns=192.168.1.1
          dns-search=
          may-fail=false
          method=manual
    - path: /etc/zincati/config.d/51-rollout-wariness.toml
      contents:
        inline: |
          [identity]
          rollout_wariness = 0.001
    - path: /etc/zincati/config.d/55-updates-strategy.toml
      contents:
        inline: |
          [updates]
          strategy = "periodic"
          [[updates.periodic.window]]
          days = [ "Sat", "Sun" ]
          start_time = "02:30"
          length_minutes = 60
    - path: /etc/alloy/config.alloy
      contents:
        inline: |
          // 1. Read directly from the systemd journal logs and pass them to the relabel stage
          loki.source.journal "system_journal" {
            max_age    = "12h"
            forward_to = [loki.relabel.journal_fields.receiver]

            labels = {
              job = "systemd-journal",
            }
          }

          // 2. Map system metadata variables and forward them to the Loki writer component
          loki.relabel "journal_fields" {
            forward_to = [loki.write.loki_endpoint.receiver]

            rule {
              target_label  = "host"
              replacement  = constants.hostname
            }

            rule {
              source_labels = ["__journal__systemd_unit"]
              target_label  = "service"
            }

            rule {
              source_labels = ["__journal__syslog_identifier"]
              target_label  = "caller"
            }
          }

          // 3. Receive the fully processed logs and push them to your central Loki engine
          loki.write "loki_endpoint" {
            endpoint {
              url = "http://192.168.1.102:3100/loki/api/v1/push"
            }
          }
    - path: /etc/containers/systemd/alloy.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Grafana Alloy Log Collector
          After=network-online.target
          Wants=network-online.target

          [Container]
          Image=docker.io/grafana/alloy:latest
          ContainerName=alloy
          SecurityLabelDisable=true
          Network=host
          # Run the run command pointing to your mounted config
          Exec=run --server.http.listen-addr=0.0.0.0:12345 /etc/alloy/config.alloy

          # Configuration File Volume
          Volume=/etc/alloy/config.alloy:/etc/alloy/config.alloy:Z,ro

          # Systemd Journal Log Volumes (Read-Only)
          Volume=/var/log/journal:/var/log/journal:ro
          Volume=/run/log/journal:/run/log/journal:ro
          Volume=/etc/machine-id:/etc/machine-id:ro

          [Service]
          Restart=always
          RestartSec=5s

          [Install]
          WantedBy=multi-user.target
    - path: /etc/containers/systemd/node-exporter.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Node Exporter for Host Metrics
          After=network-online.target

          [Container]
          Image=quay.io/prometheus/node-exporter:latest
          ContainerName=node-exporter
          AutoUpdate=registry
          Network=host
          Volume=/proc:/host/proc:ro
          Volume=/sys:/host/sys:ro
          Volume=/:/rootfs:ro
          Exec=--path.procfs=/host/proc --path.sysfs=/host/sys --path.rootfs=/rootfs

          [Service]
          Restart=always

          [Install]
          WantedBy=multi-user.target default.target
    - path: /etc/containers/systemd/backrest.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Backrest

          After=var-mnt-deadpool.mount

          [Container]
          ContainerName=backrest
          Environment=BACKREST_DATA=/data BACKREST_CONFIG=/config/config.json XDG_CACHE_HOME=/cache TZ=America/New_York
          HostName=backrest
          Image=docker.io/garethgeorge/backrest:scratch
          SecurityLabelDisable=true
          PublishPort=9898:9898
          Volume=backrest-data:/data:Z
          Volume=backrest-config:/config:Z
          Volume=backrest-cache:/cache:Z
          Volume=/:/host
          Volume=/mnt/deadpool/backups/repos:/repos

          [Service]
          Restart=always

          [Install]
          WantedBy=multi-user.target default.target
    - path: /etc/containers/systemd/tailscale.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Tailscale Network (Hardened Image)

          After=network-online.target

          [Container]
          Image=docker.io/tailscale/tailscale:latest
          ContainerName=tailscale

          # Required state persistence
          Volume=tailscale:/var/lib/tailscale:Z

          # Required device access for networking
          AddDevice=/dev/net/tun

          # Required capabilities (matches Docker docs)
          AddCapability=NET_ADMIN
          AddCapability=NET_RAW

          #Environment=TS_EXTRA_ARGS=--advertise-exit-node

          # Host networking is required for correct routing
          Network=host

          # ---- Tailscale configuration ----

          # REQUIRED: auth key (or login via device flow if omitted)
          #Environment=TS_AUTHKEY=

          # Required state dir (matches volume mount)
          Environment=TS_STATE_DIR=/var/lib/tailscale

          # Optional but common:
          #Environment=TS_USERSPACE=true
          #Environment=TS_ACCEPT_DNS=true

          AutoUpdate=registry
          [Service]
          Restart=always
          TimeoutStartSec=0

          [Install]
          WantedBy=multi-user.target
    # 1. Shared environment file
    - path: /etc/containers/systemd/paperless.env
      mode: 0600
      user: { name: root }
      contents:
        inline: |
          PAPERLESS_TIKA_ENABLED=1
          PAPERLESS_TIKA_ENDPOINT=http://127.0.0.1:9998
          PAPERLESS_GOTENBERG_ENABLED=1
          PAPERLESS_GOTENBERG_ENDPOINT=http://127.0.0.1:3000
          PAPERLESS_REDIS=redis://127.0.0.1:6379
          PAPERLESS_DBHOST=127.0.0.1
          PAPERLESS_FILENAME_FORMAT={{ created_year }}/{{ title }}
          PAPERLESS_OCR_SKIP_ARCHIVE_FILE=with_text
          POSTGRES_DB=paperless
          POSTGRES_USER=paperless
          POSTGRES_PASSWORD=password

    # 2. Valkey
    - path: /etc/containers/systemd/paperless-broker.container
      mode: 0644
      user: { name: root }
      contents:
        inline: |
          [Unit]
          Description=Valkey broker
          After=network-online.target

          [Container]
          ContainerName=paperless-broker
          Image=docker.io/valkey/valkey:latest
          Network=host
          AutoUpdate=registry

          [Service]
          Restart=always

          [Install]
          WantedBy=multi-user.target

    # 3. PostgreSQL
    - path: /etc/containers/systemd/paperless-db.container
      mode: 0644
      user: { name: root }
      contents:
        inline: |
          [Unit]
          Description=Postgres
          After=network-online.target

          [Container]
          ContainerName=paperless-db
          Image=docker.io/library/postgres:latest
          EnvironmentFile=/etc/containers/systemd/paperless.env
          Volume=paperless-pgdata:/var/lib/postgresql
          Network=host
          AutoUpdate=registry

          [Service]
          Restart=always

          [Install]
          WantedBy=multi-user.target

    # 4. Apache Tika
    - path: /etc/containers/systemd/paperless-tika.container
      mode: 0644
      user: { name: root }
      contents:
        inline: |
          [Unit]
          Description=Tika
          After=network-online.target

          [Container]
          ContainerName=paperless-tika
          Image=docker.io/apache/tika:latest
          Network=host
          AutoUpdate=registry

          [Service]
          Restart=always

          [Install]
          WantedBy=multi-user.target

    # 5. Gotenberg
    - path: /etc/containers/systemd/paperless-gotenberg.container
      mode: 0644
      user: { name: root }
      contents:
        inline: |
          [Unit]
          Description=Gotenberg
          After=network-online.target

          [Container]
          ContainerName=paperless-gotenberg
          Image=docker.io/gotenberg/gotenberg:latest
          Exec=gotenberg --chromium-disable-javascript=true --chromium-allow-insecure-localhost=true
          Network=host
          AutoUpdate=registry

          [Service]
          Restart=always

          [Install]
          WantedBy=multi-user.target

    # 6. Paperless-ngx
    - path: /etc/containers/systemd/paperless-webserver.container
      mode: 0644
      user: { name: root }
      contents:
        inline: |
          [Unit]
          Description=Paperless
          After=var-mnt-deadpool.mount

          [Unit]
          Description=Paperless-ngx

          [Container]
          ContainerName=paperless-webserver
          Image=ghcr.io/paperless-ngx/paperless-ngx:latest
          EnvironmentFile=/etc/containers/systemd/paperless.env
          Network=host

          Volume=paperless-data:/usr/src/paperless/data
          Volume=/mnt/deadpool/paperless-media:/usr/src/paperless/media
          Volume=/opt/paperless/consume:/usr/src/paperless/consume:Z

          AutoUpdate=registry

          [Service]
          Restart=always

          [Install]
          WantedBy=multi-user.target
    - path: /etc/containers/systemd/paperless-ai.container
      mode: 0644
      user: { name: root }
      contents:
        inline: |
          [Unit]
          Description=Paperless AI
          After=network-online.target

          [Container]
          ContainerName=paperless-ai
          Image=docker.io/clusterzx/paperless-ai:latest

          Environment=PAPERLESS_URL=http://127.0.0.1:8000
          Environment=PAPERLESS_API_TOKEN=2d4f7251b78a62691982738abb118f9dfd939b75

          Environment=OLLAMA_HOST=http://192.168.1.5:11434
          Environment=OLLAMA_MODEL=qwen3.5:2b-64k

          Volume=paperless-ai-data:/app/data

          PublishPort=3000:3000

          AutoUpdate=registry

          [Service]
          Restart=always

          [Install]
          WantedBy=multi-user.target
