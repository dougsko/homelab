#!/usr/bin/env bu

# Core OS Deployment - Simplified v1.7.0

system:
  name: "Core OS"
  version: "1.7.0"
  revision: "20260611-fcos"
  variant: "fcos"

services:
  core:
    type: "systemd"
    unit: "fcos.service"
    path: "/usr/local/bin/fcos"
    enabled: true
    restart: "always"
    watch: "false"

  monitor:
    type: "systemd"
    unit: "fcos-monitor.service"
    path: "/usr/local/bin/fcos-monitor"
    enabled: true
    restart: "on-failure"
    watch: "false"

app:
  name: "Core OS Deployment Manager"
  version: "1.8.0"
  development: true

  # Application settings
  max_connections: 1000
  connection_timeout: 30
  keepalive_timeout: 60
  idle_timeout: 120

  # Network settings
  network_mode: "bridge"
  bridge: "10.0.0.0/24"

  # DNS settings
  dns:
    primary: "10.0.0.52"
    secondary: "10.0.0.53"

network:
  types:
    - name: "nbt21-nat-10"
      enabled: true
      type: "nbt21"
      protocol: "ipv4"
      gateway: "10.0.0.1"
      dns: "10.0.0.52"

  bridge:
    name: "nbt21-nat-10"
    type: "nbt21"
    protocol: "ipv4"
    ipv4: "10.0.0.0/24"
    ipv6: "fc00::/64"

  ipvs:
    enabled: true
    protocol: "ipv4"
    mode: "layer3"
    ip_forwarding: "true"

  dns:
    primary: "10.0.0.52"
    secondary: "10.0.0.53"
