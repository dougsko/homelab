variant: fcos
version: 1.5.0
passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDu3b0sR30apw6ot/2esLkxRqmjjw1zfzSLYm6sfohwY doug@wario
storage:
  directories:
    - path: /mnt/deadpool
      mode: 0755
  files:
    - path: /etc/hostname
      mode: 0644
      contents: |
	server-01
    - path: /etc/fstab
      append:
	- inline: |
	    192.168.1.5:/deadpool/doug	  /mnt/deadpool/    nfs    defaults    0 0
    - path: /etc/containers/systemd/pihole.container
      mode: 0644
      contents: |
	[Unit]
	Description=Pihole

	[Container]
	ContainerName=pihole
	HostName=server-01
	Environment=TZ=America/New_York
	Environment=FTLCONF_dns_listeningMode=ALL

	#Secret=pihole_webpassword,type=env,target=FTLCONF_webserver_api_password

	Image=docker.io/pihole/pihole:latest
	AutoUpdate=registry

	Network=host

	#PublishPort=53:53/tcp
	#PublishPort=53:53/udp
	#PublishPort=8080:80/tcp
	#PublishPort=4443:443/tcp

	Volume=/mnt/deadpool/containers/server-01/pihole-etc:/etc/pihole
	Volume=/mnt/deadpool/containers/server-01/pihole-dnsmasq:/etc/dnsmasq.d

	HealthCmd=curl -fsS http://localhost:80/admin || exit 1
	HealthInterval=30s
	HealthTimeout=5s
	HealthRetries=3
	HealthStartPeriod=60s

	[Service]
	Restart=always

	[Install]
	WantedBy=default.target
systemd:
  units:
    - name: pihole.service
      dropins:
	- name: 10-create-secret.conf
	  contents: |
	    [Service]
	    # Paste the string returned from the systemd-creds encrypt command here:
	    SetCredentialEncrypted=pihole_pass:3db9a2efcc...[YOUR EXPORTED HASH STRING]...f0923a1

	    # Systemd decrypts the token at initialization into the memory directory automatically
	    ExecStartPre=-/usr/bin/bash -c "cat \${CREDENTIALS_DIRECTORY}/pihole_pass | podman secret create pihole_webpassword -"
