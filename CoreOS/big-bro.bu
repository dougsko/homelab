variant: fcos
version: 1.7.0
systemd:
  units:
    - name: podman.socket
      enabled: true
passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDu3b0sR30apw6ot/2esLkxRqmjjw1zfzSLYm6sfohwY doug@wario
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAcEz5hdQTZSv5rtcVjDeDgfA+r7AFsua8k8FQxxp8rB doug@ganon
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEri7IoTkuqP0dbjB4k/mDxuILXvwy6VsGcAbC2Q+yQ0 doug@bowser
storage:
  directories:
    - path: /mnt/deadpool
      mode: 0755
  files:
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: big-bro
    - path: /etc/fstab
      append:
        - inline: |
              192.168.1.5:/deadpool/doug    /mnt/deadpool/    nfs    defaults    0 0
    - path: /etc/NetworkManager/system-connections/enp1s0.nmconnection
      mode: 0600
      contents:
        inline: |
          [connection]
          id=enp1s0
          type=ethernet
          interface-name=enp1s0
          [ipv4]
          address1=192.168.1.102/24,192.168.1.1
          dns=192.168.1.1
          dns-search=
          may-fail=false
          method=manual
    - path: /etc/zincati/config.d/51-rollout-wariness.toml
      contents:
        inline: |
          [identity]
          rollout_wariness = 0.001
    - path: /etc/zincati/config.d/55-updates-strategy.toml
      contents:
        inline: |
          [updates]
          strategy = "periodic"
          [[updates.periodic.window]]
          days = [ "Sat", "Sun" ]
          start_time = "02:30"
          length_minutes = 60
    - path: /etc/alloy/config.alloy
      contents:
        inline: |
          // 1. Read directly from the systemd journal logs and pass them to the relabel stage
          loki.source.journal "system_journal" {
            max_age    = "12h"
            forward_to = [loki.relabel.journal_fields.receiver]

            labels = {
              job = "systemd-journal",
            }
          }

          // 2. Map system metadata variables and forward them to the Loki writer component
          loki.relabel "journal_fields" {
            forward_to = [loki.write.loki_endpoint.receiver]

            rule {
              target_label  = "host"
              replacement  = constants.hostname
            }

            rule {
              source_labels = ["__journal__systemd_unit"]
              target_label  = "service"
            }

            rule {
              source_labels = ["__journal__syslog_identifier"]
              target_label  = "caller"
            }
          }

          // 3. Receive the fully processed logs and push them to your central Loki engine
          loki.write "loki_endpoint" {
            endpoint {
              url = "http://192.168.1.102:3100/loki/api/v1/push"
            }
          }
    - path: /etc/containers/systemd/alloy.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Grafana Alloy Log Collector
          After=network-online.target
          Wants=network-online.target

          [Container]
          Image=docker.io/grafana/alloy:latest
          ContainerName=alloy
          SecurityLabelDisable=true
          Network=host
          # Run the run command pointing to your mounted config
          Exec=run --server.http.listen-addr=0.0.0.0:12345 /etc/alloy/config.alloy

          # Configuration File Volume
          Volume=/etc/alloy/config.alloy:/etc/alloy/config.alloy:Z,ro

          # Systemd Journal Log Volumes (Read-Only)
          Volume=/var/log/journal:/var/log/journal:ro
          Volume=/run/log/journal:/run/log/journal:ro
          Volume=/etc/machine-id:/etc/machine-id:ro

          [Service]
          Restart=always
          RestartSec=5s

          [Install]
          WantedBy=multi-user.target
    - path: /etc/containers/systemd/loki.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Grafana Loki Container
          After=network-online.target

          [Container]
          Image=docker.io/grafana/loki:latest
          ContainerName=loki
          # Expose Loki's default HTTP API port
          PublishPort=3100:3100
          # Mount local directories for persistent storage and configuration
          # Volume=/var/lib/loki:/loki
          # Pass command line arguments to run Loki in single-binary mode
          Exec=-config.file=/etc/loki/local-config.yaml

          [Service]
          Restart=always

          [Install]
          WantedBy=multi-user.target
    - path: /etc/containers/systemd/node-exporter.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Node Exporter for Host Metrics
          After=network-online.target

          [Container]
          Image=quay.io/prometheus/node-exporter:latest
          ContainerName=node-exporter
          AutoUpdate=registry
          Network=host
          Volume=/proc:/host/proc:ro
          Volume=/sys:/host/sys:ro
          Volume=/:/rootfs:ro
          Exec=--path.procfs=/host/proc --path.sysfs=/host/sys --path.rootfs=/rootfs

          [Service]
          Restart=always

          [Install]
          WantedBy=multi-user.target default.target
    - path: /etc/containers/systemd/cadvisor.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=cAdvisor for Podman Container Metrics
          After=network-online.target

          [Container]
          Image=gcr.io/cadvisor/cadvisor:latest
          ContainerName=cadvisor
          AutoUpdate=registry
          PublishPort=8080:8080
          SecurityLabelDisable=true
          Volume=/:/rootfs:ro
          Volume=/var/run:/var/run:ro
          Volume=/sys:/sys:ro
          Volume=/var/lib/containers/:/var/lib/containers:ro
          Volume=/dev/disk/:/dev/disk:ro

          [Service]
          Restart=always

          [Install]
          WantedBy=multi-user.target default.target
    - path: /etc/containers/systemd/backrest.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Backrest

          After=var-mnt-deadpool.mount

          [Container]
          ContainerName=backrest
          Environment=BACKREST_DATA=/data BACKREST_CONFIG=/config/config.json XDG_CACHE_HOME=/cache TZ=America/New_York
          HostName=backrest
          Image=docker.io/garethgeorge/backrest:scratch
          SecurityLabelDisable=true
          PublishPort=9898:9898
          Volume=backrest-data:/data:Z
          Volume=backrest-config:/config:Z
          Volume=backrest-cache:/cache:Z
          Volume=/:/host
          Volume=/mnt/deadpool/backups/repos:/repos

          [Service]
          Restart=always

          [Install]
          WantedBy=multi-user.target default.target
    - path: /etc/containers/systemd/netalertx.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=NetAlertX
          After=network-online.target
          Wants=network-online.target

          [Container]
          Image=ghcr.io/netalertx/netalertx:latest
          ContainerName=netalertx

          Network=host

          AddCapability=NET_ADMIN
          AddCapability=NET_RAW
          SecurityLabelDisable=true
   
          #UserNS=keep-id:uid=20211,gid=20211
          #User=20211:20211

          Volume=netalertx-data:/data:Z

          Tmpfs=/tmp

          Environment=PORT=20211

          [Container.EnvironmentData]
          APP_CONF_OVERRIDE={"GRAPHQL_PORT":"20214"}

          AutoUpdate=registry

          [Service]
          Restart=always

          [Install]
          WantedBy=multi-user.target
    - path: /etc/prometheus/prometheus.yml
      mode: 0644
      contents:
        inline: |
          global:
            scrape_interval: 15s

          scrape_configs:

            - job_name: prometheus
              static_configs:
                - targets:
                    - localhost:9090

            - job_name: node
              static_configs:
                - targets:
                    - 192.168.1.4:9100
                    - 192.168.1.5:9100
                    - 192.168.1.6:9100
                    - 192.168.1.100:9100
                    - 192.168.1.101:9100
                    - 192.168.1.102:9100

            - job_name: cadvisor
              static_configs:
                - targets:
                    - 192.168.1.4:8080
                    - 192.168.1.5:8080
                    - 192.168.1.6:98080
                    - 192.168.1.100:8080
                    - 192.168.1.101:8080
                    - 192.168.1.102:8080
    - path: /etc/containers/systemd/prometheus.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Prometheus
          Wants=network-online.target
          After=network-online.target

          [Container]
          Image=docker.io/prom/prometheus:latest
          ContainerName=prometheus

          PublishPort=9090:9090

          Volume=/etc/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
          Volume=prometheus-data:/prometheus:Z

          Exec=\
            --config.file=/etc/prometheus/prometheus.yml \
            --storage.tsdb.path=/prometheus \
            --storage.tsdb.retention.time=30d \
            --web.enable-lifecycle

          [Service]
          Restart=always

          [Install]
          WantedBy=multi-user.target
    - path: /etc/grafana/provisioning/datasources/prometheus.yaml
      mode: 0644
      contents:
        inline: |
          apiVersion: 1

          datasources:
            - name: Prometheus
              type: prometheus
              access: proxy
              url: http://host.containers.internal:9090
              isDefault: true
    - path: /etc/containers/systemd/grafana.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Grafana
          Wants=network-online.target
          After=network-online.target prometheus.service

          [Container]
          Image=docker.io/grafana/grafana:latest
          ContainerName=grafana

          PublishPort=3000:3000

          Volume=grafana-data:/var/lib/grafana:Z
          Volume=/etc/grafana/provisioning:/etc/grafana/provisioning:ro,Z

          [Service]
          Restart=always

          [Install]
          WantedBy=multi-user.target
    - path: /etc/containers/systemd/tailscale.container
      mode: 0644
      contents:
        inline: |
          [Unit]
          Description=Tailscale Network (Hardened Image)

          After=network-online.target

          [Container]
          Image=docker.io/tailscale/tailscale:latest
          ContainerName=tailscale

          # Required state persistence
          Volume=tailscale:/var/lib/tailscale:Z

          # Required device access for networking
          AddDevice=/dev/net/tun

          # Required capabilities (matches Docker docs)
          AddCapability=NET_ADMIN
          AddCapability=NET_RAW

          #Environment=TS_EXTRA_ARGS=--advertise-exit-node

          # Host networking is required for correct routing
          Network=host

          # ---- Tailscale configuration ----

          # REQUIRED: auth key (or login via device flow if omitted)
          Environment=TS_AUTHKEY=tskey-auth-kkTC8bJW8i11CNTRL-usqASEwi3V5ELCtEEJSwU58EBb9cyE1nC

          # Required state dir (matches volume mount)
          Environment=TS_STATE_DIR=/var/lib/tailscale

          # Optional but common:
          #Environment=TS_USERSPACE=true
          #Environment=TS_ACCEPT_DNS=true

          AutoUpdate=registry

          [Service]
          Restart=always
          TimeoutStartSec=0

          [Install]
          WantedBy=multi-user.target
