[Unit]
Description=Pihole

[Container]
ContainerName=pihole
Environment=TZ=America/New_York
Environment=FTLCONF_dns_listeningMode=ALL

#Secret=pihole_webpassword,target=FTLCONF_webserver_api_password

Image=docker.io/pihole/pihole:latest
AutoUpdate=registry

Network=host

Volume=/mnt/deadpool/containers/server-01/pihole-etc:/etc/pihole
Volume=/mnt/deadpool/containers/server-01/pihole-dnsmasq:/etc/dnsmasq.d

[Service]
Restart=always

[Install]
WantedBy=default.target
