[Unit]
Description=Paperless
After=var-mnt-deadpool.mount

[Unit]
Description=Paperless-ngx

[Container]
ContainerName=paperless-webserver
Image=ghcr.io/paperless-ngx/paperless-ngx:latest
EnvironmentFile=/etc/containers/systemd/paperless.env
Network=host

Volume=paperless-data:/usr/src/paperless/data
Volume=/mnt/deadpool/paperless-media:/usr/src/paperless/media
Volume=/opt/paperless/consume:/usr/src/paperless/consume:Z

AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
