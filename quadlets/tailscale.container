[Unit]
Description=Tailscale Network (Hardened Image)
After=network-online.target

[Container]
Image=docker.io/tailscale/tailscale:latest
ContainerName=tailscale

# Required state persistence
Volume=/mnt/deadpool/containers/server-01/tailscale:/var/lib/tailscale

# Required device access for networking
AddDevice=/dev/net/tun

# Required capabilities (matches Docker docs)
AddCapability=NET_ADMIN
AddCapability=NET_RAW

#Environment=TS_EXTRA_ARGS=--advertise-exit-node

# Host networking is required for correct routing
Network=host

# ---- Tailscale configuration ----

# REQUIRED: auth key (or login via device flow if omitted)
#Environment=TS_AUTHKEY=

# Required state dir (matches volume mount)
Environment=TS_STATE_DIR=/var/lib/tailscale

# Optional but common:
#Environment=TS_USERSPACE=true
#Environment=TS_ACCEPT_DNS=true

AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=0

[Install]
WantedBy=default.target
