[Unit]
Description=Frigate NVR
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=frigate
Image=ghcr.io/blakeblackshear/frigate:stable-tensorrt
AutoUpdate=registry

#
# NVIDIA GPU
#
AddDevice=nvidia.com/gpu=all

#
# Shared memory
#
ShmSize=256m

#
# Notifications
#
#Notify=true

#
# Performance counters (optional but recommended)
#
AddCapability=PERFMON

#
# Time
#
Volume=/etc/localtime:/etc/localtime:ro

#
# Configuration
#
Volume=frigate-config:/config:Z

#
# Database
#
Volume=frigate-database:/database:Z

#
# Recordings / snapshots
#
Volume=/deadpool/doug/frigate/media:/media/frigate:Z

#
# Cache
#
Tmpfs=/tmp/cache:size=1G

#
# Environment
#
Environment=TZ=America/New_York
Environment=NVIDIA_VISIBLE_DEVICES=all
Environment=NVIDIA_DRIVER_CAPABILITIES=compute,video,utility
Environment=FRIGATE_RTSP_PASSWORD=your_password

Network=host
#
# Web UI
#
#PublishPort=5000:5000

#
# RTSP restream
#
#PublishPort=8554:8554

#
# WebRTC
#
#PublishPort=8555:8555/tcp
#PublishPort=8555:8555/udp

#
# Optional RTMP
#
#PublishPort=1935:1935

[Service]
Restart=always
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
