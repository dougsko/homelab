[Unit]
Description=NetAlertX
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/netalertx/netalertx:latest
ContainerName=netalertx

Network=host

AddCapability=NET_ADMIN
AddCapability=NET_RAW
SecurityLabelDisable=true

#UserNS=keep-id:uid=20211,gid=20211
#User=20211:20211

Volume=netalertx-data:/data:Z

Tmpfs=/tmp

Environment=PORT=20211

[Container.EnvironmentData]
APP_CONF_OVERRIDE={"GRAPHQL_PORT":"20214"}

AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
